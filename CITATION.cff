    given-names: Tetsuo
    email: tntetsu@gmail.com
repository-code: "https://github.com/tntetsu/JSVisualizer"
url: "https://tntetsu.github.io/JSVisualizer/"
license: MIT
date-released: "2026-06-16"
version: "1.7.0"

